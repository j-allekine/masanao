// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../docs/database/ERD.svg"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id
  name          String
  email         String
  username      String?   @unique
  role          String    @default("staff")
  disabled      Boolean   @default(false)
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Unit {
  id                       String               @id
  name                     String
  abbreviation             String
  normalizedName           String               @unique
  normalizedAbbreviation   String               @unique
  active                   Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  baseUnitItems            Item[]               @relation("ItemBaseUnit")
  alternateUnitConversions ItemUnitConversion[] @relation("ItemUnitConversionAlternateUnit")
  selectedDeliveryReceiptLines DeliveryReceiptLine[] @relation("DeliveryReceiptLineSelectedUnit")
  baseDeliveryReceiptLines     DeliveryReceiptLine[] @relation("DeliveryReceiptLineBaseUnit")
  inventoryLedgerMovements     InventoryLedgerMovement[] @relation("InventoryLedgerMovementBaseUnit")

  @@map("unit")
}

model Category {
  id             String   @id
  name           String
  description    String?
  normalizedName String   @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items          Item[]

  @@map("category")
}

model Item {
  id              String               @id
  name            String
  normalizedName  String               @unique(map: "item_normalized_name_key")
  categoryId      String
  baseUnitId      String
  note            String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  category        Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  baseUnit        Unit                 @relation("ItemBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  unitConversions ItemUnitConversion[]
  deliveryReceiptLines DeliveryReceiptLine[]
  inventoryLedgerMovements InventoryLedgerMovement[] @relation("InventoryLedgerMovementItem")

  @@index([categoryId])
  @@index([baseUnitId])
  @@map("item")
}

model ItemUnitConversion {
  id               String   @id
  itemId           String
  alternateUnitId  String
  baseUnitQuantity String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  alternateUnit    Unit     @relation("ItemUnitConversionAlternateUnit", fields: [alternateUnitId], references: [id], onDelete: Restrict)

  @@unique([itemId, alternateUnitId, baseUnitQuantity])
  @@index([itemId])
  @@index([alternateUnitId])
  @@map("item_unit_conversion")
}

model Office {
  id                     String   @id
  name                   String
  abbreviation           String?
  headName               String?
  headDesignation        String?
  officialEmail          String?
  contactNumber          String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  // Internal comparison keys; omitted from the public Office read contract.
  normalizedName         String   @unique
  normalizedAbbreviation String?  @unique

  @@map("office")
}

model Vendor {
  id             String          @id
  name           String
  normalizedName String          @unique(map: "vendor_normalized_name_key")
  contactPerson  String?
  contactNumber  String?
  email          String?
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  deliveryReceipts DeliveryReceipt[]

  @@map("vendor")
}

model PurchaseOrder {
  id                        String   @id
  purchaseOrderNo           String
  normalizedPurchaseOrderNo String   @unique(map: "purchase_order_normalized_no_key")
  vendorId                  String
  referenceNumber           String?
  note                      String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  vendor                    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  deliveryReceipts          DeliveryReceipt[]

  @@index([vendorId])
  @@map("purchase_order")
}

model DeliveryReceipt {
  id                      String                @id
  purchaseOrderId         String
  vendorId                String
  vendorName              String
  purchaseOrderNo         String
  receiptNo               String
  normalizedReceiptNo     String
  receiptDate             DateTime
  note                    String?
  postedAt                DateTime              @default(now())
  purchaseOrder           PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  vendor                  Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines                   DeliveryReceiptLine[]

  @@unique([vendorId, normalizedReceiptNo])
  @@index([purchaseOrderId])
  @@map("delivery_receipt")
}

model DeliveryReceiptLine {
  id                              String          @id
  deliveryReceiptId               String
  itemId                          String
  selectedUnitId                  String
  baseUnitId                      String
  itemName                        String
  selectedUnitName                String
  baseUnitName                    String
  enteredQuantity                 String
  conversionFactor                String
  calculatedBaseUnitQuantity      String
  actualReceivedBaseUnitQuantity  String
  varianceNote                    String?
  deliveryReceipt                 DeliveryReceipt @relation(fields: [deliveryReceiptId], references: [id], onDelete: Restrict)
  item                            Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  selectedUnit                    Unit            @relation("DeliveryReceiptLineSelectedUnit", fields: [selectedUnitId], references: [id], onDelete: Restrict)
  baseUnit                        Unit            @relation("DeliveryReceiptLineBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  inventoryLedgerMovements        InventoryLedgerMovement[]

  @@index([deliveryReceiptId])
  @@index([itemId])
  @@map("delivery_receipt_line")
}

model InventoryLedgerMovement {
  id                    String              @id
  deliveryReceiptLineId String              @unique
  itemId                String
  baseUnitId            String
  quantity              String
  movementType          String
  occurredAt            DateTime
  deliveryReceiptLine   DeliveryReceiptLine @relation(fields: [deliveryReceiptLineId], references: [id], onDelete: Restrict)
  item                  Item                @relation("InventoryLedgerMovementItem", fields: [itemId], references: [id], onDelete: Restrict)
  baseUnit              Unit                @relation("InventoryLedgerMovementBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@map("inventory_ledger_movement")
}

model ActivityDesign {
  id               String     @id
  activityDesignNo String     @unique
  fiscalYear       Int
  title            String
  aipReferenceCode String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  activities       Activity[]

  @@map("activity_design")
}

model Activity {
  id                      String         @id
  activityDesignId        String
  name                    String
  officeName              String
  particulars             String?
  scheduledDate           DateTime
  venue                   String?
  plannedParticipantCount Int?
  plannedBudgetCentavos   BigInt?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  activityDesign          ActivityDesign @relation(fields: [activityDesignId], references: [id], onDelete: Restrict)
  mealSchedules           MealSchedule[]

  @@index([activityDesignId])
  @@map("activity")
}

model MealSchedule {
  id              String   @id
  activityId      String
  label           String
  mealTime        String
  plannedServings Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@map("meal_schedule")
}
